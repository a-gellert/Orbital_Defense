-- camera_shake.script
local rendercam = require "rendercam.rendercam"

local MIN_ZOOM = 0.55   -- Максимальное приближение к ядру
local MAX_ZOOM = 2.0    -- Максимальное отдаление (обзор всех 6 орбит)
local DEFAULT_ZOOM = 1.0

function init(self)
	msg.post(".", "acquire_input_focus")
	self.initial_pos = go.get_position()
	self.target_scale = rendercam.get_ortho_scale() or DEFAULT_ZOOM
	self.current_scale = self.target_scale
	self.last_pinch_dist = nil
end

local function shake(self, intensity, duration)
	local initial_pos = vmath.vector3(0, 0, 0)
	local elapsed = 0
	local interval = 0.02

	timer.delay(interval, true, function(self, handle, time_elapsed)
		elapsed = elapsed + interval

		if elapsed >= duration then
			go.set_position(initial_pos)
			timer.cancel(handle)
		else
			local offset = vmath.vector3(
				math.random(-intensity, intensity),
				math.random(-intensity, intensity),
				0
			)
			go.set_position(initial_pos + offset)
			intensity = intensity * 0.9 
		end
	end)
end

function update(self, dt)
	-- Плавная интерполяция зума камеры
	if math.abs(self.current_scale - self.target_scale) > 0.001 then
		self.current_scale = vmath.lerp(math.min(1.0, dt * 14.0), self.current_scale, self.target_scale)
		rendercam.set_ortho_scale(self.current_scale)
	end
end

function on_input(self, action_id, action)
	-- 1. Зум колесиком мыши
	if action_id == hash("wheel_up") or (action.wheel_y and action.wheel_y > 0) then
		-- Приближение (Zoom IN -> уменьшаем orthoScale)
		self.target_scale = math.max(MIN_ZOOM, math.min(MAX_ZOOM, self.target_scale - 0.12))
		return false

	elseif action_id == hash("wheel_down") or (action.wheel_y and action.wheel_y < 0) then
		-- Отдаление (Zoom OUT -> увеличиваем orthoScale)
		self.target_scale = math.max(MIN_ZOOM, math.min(MAX_ZOOM, self.target_scale + 0.12))
		return false

	-- 2. Зум щипковыми жестами (Pinch to Zoom) для тачскринов / мобильных
	elseif action_id == hash("touch_multi") or (action.touch and #action.touch >= 2) then
		if action.touch and #action.touch >= 2 then
			local t1 = action.touch[1]
			local t2 = action.touch[2]

			local dx = t1.x - t2.x
			local dy = t1.y - t2.y
			local dist = math.sqrt(dx * dx + dy * dy)

			if t1.pressed or t2.pressed or not self.last_pinch_dist then
				self.last_pinch_dist = dist
			elseif t1.released or t2.released then
				self.last_pinch_dist = nil
			elseif self.last_pinch_dist and self.last_pinch_dist > 0 then
				local pinch_delta = dist - self.last_pinch_dist
				-- Разведение пальцев в стороны (pinch_delta > 0) -> Приближение
				-- Сведение пальцев вместе (pinch_delta < 0) -> Отдаление
				local zoom_factor = pinch_delta * 0.003
				self.target_scale = math.max(MIN_ZOOM, math.min(MAX_ZOOM, self.target_scale - zoom_factor))
				self.last_pinch_dist = dist
			end
		else
			self.last_pinch_dist = nil
		end
		return false
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("shake") then
		shake(self, message.intensity or 5, message.duration or 0.2)
	elseif message_id == hash("set_zoom") then
		local z = message.zoom or DEFAULT_ZOOM
		self.target_scale = math.max(MIN_ZOOM, math.min(MAX_ZOOM, z))
	end
end