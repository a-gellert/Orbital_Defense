local druid = require "druid.druid"
local prog = require "main.progression"

local DIMS = 200 -- Константа размера элемента

--- 1. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (ОЧИСТКА И СОЗДАНИЕ) ---

local function clear_content(self)
	for _, nodes in ipairs(self.spawned_nodes or {}) do
		for _, node in pairs(nodes) do
			gui.delete_node(node)
		end
	end
	self.spawned_nodes = {}

	if self.upgrade_buttons then
		for _, btn in ipairs(self.upgrade_buttons) do
			self.druid:remove(btn)
		end
	end
	self.upgrade_buttons = {}
end

-- Функция динамического изменения размера текста (Scale Hack)
local function fit_text(node, max_width)
	local text = gui.get_text(node)
	local metrics = gui.get_text_metrics(gui.get_font(node), text).width
	if metrics > max_width then
		local s = max_width / metrics
		gui.set_scale(node, vmath.vector3(s, s, 1))
	else
		gui.set_scale(node, vmath.vector3(1, 1, 1))
	end
end

-- Создание кнопки турели (для вкладки Turrets)
local function add_turret_button(self, turret_id, turret_data, index)
	local template_node = gui.get_node("btn_buy_turret")
	if not template_node then return end

	local nodes = gui.clone_tree(template_node)
	table.insert(self.spawned_nodes, nodes)

	local root = nodes[hash("btn_buy_turret")]
	local name_node = nodes[hash("turret_name")]
	local price_node = nodes[hash("turret_price")]

	local content_node = gui.get_node("content_node")
	gui.set_parent(root, content_node)
	gui.set_enabled(root, true)

	-- Установка текста и авто-фит
	if name_node then 
		gui.set_text(name_node, turret_id:upper())
		fit_text(name_node, 160)
	end

	if price_node then 
		gui.set_text(price_node, prog.format_num(turret_data.price) .. " 💰")
	end

	-- Позиционирование в скролле
	local y = -(self.item_offset_y + index * DIMS)
	gui.set_position(root, vmath.vector3(0, y, 0))

	-- Сохраняем ссылки для апдейта цвета
	self.turret_buttons[turret_id] = {
		root = root,
		price_node = price_node,
		name_node = name_node,
		data = turret_data
	}

	local btn = self.druid:new_button(root, function()
		self:buy_turret(turret_id)
	end)
	table.insert(self.upgrade_buttons, btn)
end

-- Универсальная функция для простых апгрейдов (Economy/Orbits)
local function add_upgrade_item(self, title, price, callback, index)
	local nodes = gui.clone_tree(gui.get_node("btn_buy_turret")) -- Используем тот же шаблон
	table.insert(self.spawned_nodes, nodes)

	local root = nodes[hash("btn_buy_turret")]
	local name_node = nodes[hash("turret_name")]
	local price_node = nodes[hash("turret_price")]

	gui.set_parent(root, gui.get_node("content_node"))
	gui.set_enabled(root, true)
	gui.set_text(name_node, title)
	gui.set_text(price_node, prog.format_num(price) .. " 💰")

	fit_text(name_node, 160)

	local y = -(self.item_offset_y + index * DIMS)
	gui.set_position(root, vmath.vector3(0, y, 0))

	local btn = self.druid:new_button(root, callback)
	table.insert(self.upgrade_buttons, btn)
end

--- 2. ЛОГИКА ВКЛАДОК ---

local function build_turrets_panel(self)
	clear_content(self)
	self.turret_buttons = {}
	local count = 0
	for id, turret in pairs(prog.data.turrets) do
		add_turret_button(self, id, turret, count)
		count = count + 1
	end
end

local function build_economy_panel(self)
	clear_content(self)
	local gpk_lvl = prog.data.economy.level_gpk or 1
	local gpk_price = math.floor(50 * (1.15 ^ gpk_lvl))

	add_upgrade_item(self, "GOLD PER KILL", gpk_price, function()
		if prog.data.gold >= gpk_price then
			prog.data.gold = prog.data.gold - gpk_price
			prog.data.economy.level_gpk = gpk_lvl + 1
			self:refresh_tab("economy")
		end
	end, 0)
end

local function build_orbits_panel(self)
	clear_content(self)
	local orbit_price = 1000 * (prog.data.orbits.count or 1)
	add_upgrade_item(self, "ADD ORBIT", orbit_price, function()
		if prog.data.gold >= orbit_price then
			prog.data.gold = prog.data.gold - orbit_price
			prog.data.orbits.count = (prog.data.orbits.count or 1) + 1
			msg.post("/logic#game_manager", "add_orbit")
			self:refresh_tab("orbits")
		end
	end, 0)
end

--- 3. СИСТЕМНЫЕ ФУНКЦИИ ---

local function update_balance(self)
	local coin_node = gui.get_node("coin_balance_txt")
	if coin_node then
		gui.set_text(coin_node, prog.format_num(prog.data.gold or 0) .. " 💰")
	end
end


local function buy_turret(self, turret_id)
	local turret = prog.data.turrets[turret_id]
	if not turret then return end

	if prog.data.gold >= turret.price then
		prog.data.gold = prog.data.gold - turret.price
		turret.unlocked = true
		msg.post("/logic#game_manager", "upgrade_purchased", { id = turret_id })
		self:update_balance()
		self:refresh_tab("turrets")
	end
end

local function toggle_menu(self)
	self.is_menu_open = not self.is_menu_open
	local root = gui.get_node("root")
	gui.set_enabled(root, self.is_menu_open)
	gui.set_visible(root, self.is_menu_open)

	if self.is_menu_open then
		self:refresh_tab(self.current_tab or "turrets")
	end
end
local function pause(self)
	self.is_pause = not self.is_pause

	if self.is_pause then poki_sdk.gameplay_stop()
	elseif  not self.is_pause then poki_sdk.gameplay_start()
	end
	
end

local function refresh_tab(self, tab_name)
	self.current_tab = tab_name
	if tab_name == "turrets" then build_turrets_panel(self)
	elseif tab_name == "economy" then build_economy_panel(self)
	elseif tab_name == "orbits" then build_orbits_panel(self) end

	local total_height = #self.spawned_nodes * DIMS
	self.scroll:set_size(vmath.vector3(400, math.max(total_height, 1), 0))
end

--- 4. ИНИЦИАЛИЗАЦИЯ И СОБЫТИЯ ---

function init(self)
	-- Привязка методов к self
	self.refresh_tab = refresh_tab
	self.toggle_menu = toggle_menu
	self.pause = pause
	self.update_balance = update_balance
	self.buy_turret = buy_turret
	self.druid = druid.new(self)
	self.scroll = self.druid:new_scroll("view_port", "content_node")

	self.spawned_nodes = {}
	self.upgrade_buttons = {}
	self.turret_buttons = {}
	self.is_menu_open = false
	self.is_pause = false
	self.item_offset_y = 20

	-- Кнопки вкладок
	self.druid:new_button("btn_tab_orbits", function() self:refresh_tab("orbits") end)
	self.druid:new_button("btn_tab_turrets", function() self:refresh_tab("turrets") end)
	self.druid:new_button("btn_tab_economy", function() self:refresh_tab("economy") end)
	self.druid:new_button("btn_toggle_menu", function() self:toggle_menu() end)
	self.druid:new_button("pause", function() self:pause() end)

	gui.set_enabled(gui.get_node("root"), false)
	self:update_balance()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("refresh_balance") then
		self:update_balance()
		-- Опционально: если меню открыто, обновляем цвета
		if self.is_menu_open then self:refresh_tab(self.current_tab) end
	end
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end