-- game_manager.script
local prog = require "main.progression"

function init(self)
	self.total_kills = 0
end

function on_message(self, message_id, message, sender)
	-- Уничтожение врага: начисляем золото с учетом перка gold_per_kill
	if message_id == hash("enemy_killed") or message_id == hash("enemy_defeated") then
		self.total_kills = self.total_kills + 1
		local reward = message.amount or prog.get_gold_per_kill()
		prog.data.gold = prog.data.gold + reward

		msg.post("main:/gui#game", "refresh_balance")
	end
end