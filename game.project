[bootstrap]
main_collection = /main/loader.collectionc
render = /rendercam/rendercam.renderc

[script]
shared_state = 1

[display]
width = 390
height = 780
high_dpi = 1

[physics]
gravity_y = 0.0
scale = 0.01
max_collision_object_count = 1024
max_collisions = 512
max_contacts = 512
trigger_overlap_capacity = 64

[html5]
show_made_with_defold = 0
show_fullscreen_button = 0
show_console_banner = 0
heap_size = 128
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = Orbital Defense
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/12.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip
dependencies#2 = https://github.com/defold/extension-poki-sdk/archive/refs/tags/4.1.0.zip

[sprite]
max_count = 2048

[particle_fx]
max_count = 512
max_emitter_count = 512
max_particle_count = 4096
max_particle_buffer_count = 4096

[factory]
max_count = 256

[label]
max_count = 256

