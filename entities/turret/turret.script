local config = require "main.game_config"

go.property("turret_type", hash("blaster"))
go.property("level", 1)

-- Таблица паттернов стрельбы
local PATTERNS = {
	-- Бластер и Пульсатор используют один и тот же метод (разница только в статах из конфига)
	[hash("blaster")] = function(self, pos, rot)
		factory.create("#bullet_factory", pos, rot, {
			damage = self.damage, speed = self.stats.bullet_speed
		})
	end,

	[hash("pulse")] = function(self, pos, rot)
		factory.create("#bullet_factory", pos, rot, {
			damage = self.damage, speed = self.stats.bullet_speed
		})
	end,

	-- Ракетница спавнит ракету и передает ей цель для наведения
	[hash("rocket")] = function(self, pos, rot)
		-- Важно: ракете нужна цель (target_id)
		factory.create("#rocket_factory", pos, rot, {
			damage = self.damage, 
			speed = self.stats.bullet_speed,
			target_id = self.current_target
		})
	end
}

function init(self)
	local type_str = "blaster"
	sprite.play_flipbook("#sprite", "t_blaster")
	if self.turret_type == hash("pulse") then 
		type_str = "pulse"
		sprite.play_flipbook("#sprite", "t_laser")
	elseif self.turret_type == hash("rocket") then 
		type_str = "rocket"
		sprite.play_flipbook("#sprite", "t_racket")
	 end

	local stats = config.turret_stats[type_str] or config.turret_stats.blaster
	self.stats = stats
	self.cooldown = 0
	self.current_target = nil
	self.damage = stats.damage * config.level_multiplier(self.level)
end

function fire(self, pos, rot)
	self.cooldown = self.stats.rate
	local shoot_func = PATTERNS[self.turret_type] or PATTERNS[hash("blaster")]
	shoot_func(self, pos, rot)
end

function update(self, dt)
	if self.cooldown > 0 then self.cooldown = self.cooldown - dt end

	if self.current_target and go.exists(self.current_target) then
		local my_pos = go.get_world_position()
		local target_pos = go.get_world_position(self.current_target)
		local dir = target_pos - my_pos
		local target_angle = math.atan2(dir.y, dir.x) 

		-- Поворот спрайта
		local offset = - math.pi / 2 
		local target_quat = vmath.quat_rotation_z(target_angle + offset)
		local parent_quat = go.get_world_rotation(go.get_parent())
		go.set_rotation(vmath.conj(parent_quat) * target_quat)

		if self.cooldown <= 0 then
			fire(self, my_pos, vmath.quat_rotation_z(target_angle))
		end
	else
		self.current_target = nil
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_target") then
		self.current_target = message.target_id
	elseif message_id == hash("upgrade_turret") then
		self.level = self.level + 1
		self.damage = self.stats.damage * config.level_multiplier(self.level)
	end
end