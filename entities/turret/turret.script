-- turret.script
local config = require "main.game_config"
go.property("turret_type", hash("blaster"))
go.property("level", 1)
go.property("turn_speed", 0.0)        -- радианы/с; 0.0 = мгновенная поворотка
go.property("fire_angle_threshold", 0.2) -- порог (рад) для точности перед выстрелом, если нужен

function init(self)
	local stats = config.turret_stats[self.turret_type]
	if not stats then
		stats = config.turret_stats.blaster
		self.turret_type = hash("blaster")
	end
	poki_sdk.gameplay_start()
	self.stats = stats
	self.cooldown = 0
	self.current_target = nil
	self.damage = stats.damage * config.level_multiplier(self.level)

	-- Визуал цвета: убедитесь, что у вас node называется "sprite" (как в вашем примере)
	go.set("#sprite", "tint", vmath.vector4(unpack(stats.color)))
end

function build_turret(self, turret_type)
	if self.turret_id and go.exists(self.turret_id) then return end

	local local_pos = vmath.vector3(0, 0, 0.5)

	self.turret_id = factory.create("#turret_factory", nil, nil, {
		turret_type = turret_type or hash("blaster"),
		level = 1
	})

	if self.turret_id then
		go.set_parent(self.turret_id, go.get_id(), false)
		go.set_position(local_pos, self.turret_id)
	end
end

-- Простая функция выстрела (ваша оригинальная)
function fire(self, pos, rot)
	self.cooldown = self.stats.rate

	factory.create("#bullet_factory", pos, rot, {
		damage = self.damage,
		speed = self.stats.bullet_speed,
		is_enemy = false
	})
end

-- Вспомогательная: безопасно получить мировую позицию/вращение цели
local function valid_target(id)
	return id and go.exists(id)
end
function update(self, dt)

	if self.cooldown > 0 then
		self.cooldown = self.cooldown - dt
	end

	if self.current_target and go.exists(self.current_target) then

		local my_pos = go.get_world_position()
		local target_pos = go.get_world_position(self.current_target)

		local dir = target_pos - my_pos
		local angle = math.atan2(dir.y, dir.x)

		-- МГНОВЕННЫЙ поворот (самый стабильный вариант)
		go.set_rotation(vmath.quat_rotation_z(angle))

		-- Стрельба
		if self.cooldown <= 0 then
			fire(self, my_pos, go.get_rotation())
		end

	else
		self.current_target = nil
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_target") then
		-- message.target_id может быть nil — это валидный сигнал снять цель
		self.current_target = message.target_id
	end

	if message_id == hash("upgrade_turret") then
		self.level = self.level + 1
		self.damage = self.stats.damage * config.level_multiplier(self.level)
	end
end