-- turret.script
local config = require "main.game_config"
local prog = require "main.progression"
local registry = require "main.enemy_registry"

go.property("turret_type", hash("blaster"))
go.property("level", 1)

-- Поиск ближайшей цели не каждый кадр: раз в RETARGET_INTERVAL или сразу, если цель погибла
local RETARGET_INTERVAL = 0.15

local TYPE_NAMES = {
	[hash("blaster")] = { name = "blaster", anim = "t_blaster" },
	[hash("pulse")]   = { name = "pulse",   anim = "t_pulse" },
	[hash("rocket")]  = { name = "rocket",  anim = "t_racket" },
	[hash("laser")]   = { name = "laser",   anim = "t_laser" },
	[hash("plasma")]  = { name = "plasma",  anim = "t_plasma" },
	[hash("tesla")]   = { name = "tesla",   anim = "t_tesla" }
}

local BLASTER = hash("blaster")
local Z_OFFSET = vmath.vector3(0, 0, 0.2)

local function shoot_bullet(self, pos, rot, props)
	factory.create("#bullet_factory", pos + Z_OFFSET, rot, props)
	self.out = factory.create("#bullet_out_factory", pos, rot)
	go.set_parent(self.out, go.get_id(), true)
end

-- Паттерны стрельбы для всех 6 турелей
local PATTERNS = {
	[hash("blaster")] = function(self, pos, rot, speed, pierce)
		shoot_bullet(self, pos, rot, {
			damage = self.damage, speed = speed, pierce = pierce,
			bullet_type = hash("blaster"), max_range = self.stats.range * 1.3
		})
	end,

	[hash("pulse")] = function(self, pos, rot, speed, pierce)
		shoot_bullet(self, pos, rot, {
			damage = self.damage, speed = speed, pierce = pierce,
			bullet_type = hash("pulse"), max_range = self.stats.range * 1.3
		})
	end,

	[hash("rocket")] = function(self, pos, rot, speed, pierce)
		factory.create("#rocket_factory", pos + Z_OFFSET, rot, {
			damage = self.damage, speed = speed, target_id = self.current_target
		})
	end,

	[hash("laser")] = function(self, pos, rot, speed, pierce)
		shoot_bullet(self, pos, rot, {
			damage = self.damage, speed = speed, pierce = 3 + pierce,
			bullet_type = hash("laser"), max_range = self.stats.range * 1.4
		})
	end,

	[hash("plasma")] = function(self, pos, rot, speed, pierce)
		shoot_bullet(self, pos, rot, {
			damage = self.damage, speed = speed, pierce = pierce,
			bullet_type = hash("plasma"), splash_radius = 70, max_range = self.stats.range * 1.3
		})
	end,

	[hash("tesla")] = function(self, pos, rot, speed, pierce)
		shoot_bullet(self, pos, rot, {
			damage = self.damage, speed = speed, pierce = 0,
			bullet_type = hash("tesla"), chain_count = 2 + prog.get_chain_count(),
			max_range = self.stats.range * 1.3
		})
	end
}

local function update_damage(self)
	local turret_data = prog.data.turrets[self.type_str]
	local lvl = (turret_data and turret_data.level_dmg) or self.level or 1
	self.damage = self.stats.damage * config.level_multiplier(lvl)
end

local function fire(self, pos, rot, target_angle)
	self.cooldown = self.stats.rate / prog.get_fire_rate_multiplier()

	update_damage(self)
	if prog.is_overdrive then
		self.damage = self.damage * prog.get_damage_multiplier()
	end

	-- Отдача выстрела турели (Recoil Punch)
	go.set("#sprite", "scale", vmath.vector3(0.12, 0.17, 1))
	go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.15, 0.15, 1), go.EASING_OUTELASTIC, 0.18)

	local speed = self.stats.bullet_speed * prog.get_projectile_speed_multiplier()
	local pierce = (self.turret_type == BLASTER) and prog.get_pierce_count() or 0

	local shoot_func = PATTERNS[self.turret_type] or PATTERNS[BLASTER]
	shoot_func(self, pos, rot, speed, pierce)

	-- Мультишот: шанс выстрелить дополнительным снарядом
	local multi_chance = prog.get_multishot_chance()
	if multi_chance > 0 and math.random() < multi_chance then
		local spread = math.random() > 0.5 and 0.18 or -0.18
		shoot_func(self, pos, vmath.quat_rotation_z(target_angle + spread), speed, pierce)
	end
end

function init(self)
	local info = TYPE_NAMES[self.turret_type] or TYPE_NAMES[BLASTER]
	self.type_str = info.name
	sprite.play_flipbook("#sprite", info.anim)

	self.stats = config.turret_stats[self.type_str]
	self.cooldown = 0
	self.current_target = nil
	-- Случайный сдвиг, чтобы турели не искали цели в одном и том же кадре
	self.retarget_timer = math.random() * RETARGET_INTERVAL
	update_damage(self)
end

function update(self, dt)
	if prog.is_paused then return end

	if self.cooldown > 0 then self.cooldown = self.cooldown - dt end

	local my_pos = go.get_world_position()

	self.retarget_timer = self.retarget_timer - dt
	if self.retarget_timer <= 0 or not registry.has(self.current_target) then
		self.retarget_timer = RETARGET_INTERVAL
		self.current_target = registry.find_closest(my_pos.x, my_pos.y, self.stats.range)
	end

	local tx, ty = registry.get_pos(self.current_target)
	if not tx then
		self.current_target = nil
		return
	end

	-- Поворот к цели с учетом вращения орбиты-родителя
	local target_angle = math.atan2(ty - my_pos.y, tx - my_pos.x)
	local target_quat = vmath.quat_rotation_z(target_angle)
	local parent = go.get_parent()
	if parent then
		go.set_rotation(vmath.conj(go.get_world_rotation(parent)) * target_quat)
	else
		go.set_rotation(target_quat)
	end

	if self.cooldown <= 0 then
		fire(self, my_pos, target_quat, target_angle)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("upgrade_turret") then
		self.level = self.level + 1
		update_damage(self)
	end
end
