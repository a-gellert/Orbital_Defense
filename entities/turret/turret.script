-- entities/turret/turret.script
local config = require "main.game_config"

go.property("turret_type", hash("blaster"))
go.property("level", 1)

function init(self)
	print("🔫 Turret INIT! Type:", self.turret_type)

	local stats = config.turret_stats[self.turret_type]
	if not stats then
		stats = config.turret_stats.blaster
		self.turret_type = hash("blaster")
	end

	self.stats = stats
	self.cooldown = 0
	self.current_target = nil
	self.damage = stats.damage * (config.level_multiplier and config.level_multiplier(self.level) or 1)

	if go.exists("#sprite") then
--		go.set_color("#sprite", vmath.vector4(1, 1, 1, 1))
	end
end

function fire(self, pos, rot)
	self.cooldown = self.stats.rate
	factory.create("#bullet_factory", pos, rot, {
		damage = self.damage,
		speed = self.stats.bullet_speed,
		is_enemy = false
	})
end

function update(self, dt)
	if self.cooldown > 0 then
		self.cooldown = self.cooldown - dt
	end

	if self.current_target and go.exists(self.current_target) then
		local my_pos = go.get_world_position()
		local target_pos = go.get_world_position(self.current_target)
		local dir = target_pos - my_pos
		local angle = math.atan2(dir.y, dir.x)

		go.set_rotation(vmath.quat_rotation_z(angle))

		if self.cooldown <= 0 then
			fire(self, my_pos, go.get_rotation())
		end
	else
		self.current_target = nil
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_target") then
		self.current_target = message.target_id
	end

	if message_id == hash("upgrade_turret") then
		self.level = self.level + 1
		self.damage = self.stats.damage * config.level_multiplier(self.level)
	end
end