-- turret.script
local config = require "main.game_config"

go.property("turret_type", hash("blaster"))

function init(self)
	local type_str = "blaster"
	-- Если вы планируете передавать тип через factory properties, раскомментируйте:
	-- if self.turret_type then type_str = tostring(self.turret_type) end

	if self.turret_type == hash("sniper") then type_str = "sniper" end

	if config and config.turret_stats then
		self.stats = config.turret_stats[type_str]
	else
		self.stats = { damage = 10, rate = 0.5, range = 200, bullet_speed = 600, turn_speed = 5.0 }
	end

	self.timer = 0
	self.current_target = nil
	self.targets_in_range = {} 

	-- Отладка: видим ли мы этот принт? Если нет - турель не создается.
	print("Turret Init: Pos:", go.get_position(), "Rot:", go.get_rotation())
	print(go.get_scale())
end

local function find_nearest_target(self)
	local my_pos = go.get_world_position()
	local nearest_dist = math.huge
	local nearest_id = nil
	local valid_targets = {}

	for id, _ in pairs(self.targets_in_range) do
		if go.exists(id) then
			valid_targets[id] = true
			local enemy_pos = go.get_world_position(id)
			local dist = vmath.length_sqr(enemy_pos - my_pos)
			-- Проверка дальности (опционально, но полезно)
			if dist < nearest_dist and dist < (self.stats.range * self.stats.range) then
				nearest_dist = dist
				nearest_id = id
			end
		end
	end
	self.targets_in_range = valid_targets
	return nearest_id
end

function update(self, dt)
	-- 1. Поиск цели
	if not self.current_target or not go.exists(self.current_target) then
		self.current_target = find_nearest_target(self)
	end

	-- 2. Логика боя
	-- В функции update, замени блок поворота на этот:
	if self.current_target then
		local my_pos = go.get_world_position()
		local target_pos = go.get_world_position(self.current_target)

		local diff = target_pos - my_pos
		-- Проверка: если враг прямо в нас, не дергаемся
		if vmath.length_sqr(diff) > 0.0001 then 
			local angle = math.atan2(diff.y, diff.x)
			local target_world_rot = vmath.quat_rotation_z(angle)

			local parent_id = go.get_parent()
			local parent_rot = parent_id and go.get_world_rotation(parent_id) or vmath.quat()

			local target_local_rot = vmath.conj(parent_rot) * target_world_rot

			local current_local_rot = go.get_rotation()
			local new_rot = vmath.slerp(dt * self.stats.turn_speed, current_local_rot, target_local_rot)
			go.set_rotation(new_rot)

			-- Стреляем, только если почти довернулись к цели (угол отклонения небольшой)
			-- Это защитит от стрельбы "спиной", пока турель разворачивается
			local dot = vmath.dot(vmath.rotate(current_local_rot, vmath.vector3(1,0,0)), vmath.normalize(diff))
			if dot > 0.9 and self.timer <= 0 then 
				factory.create("#bullet_factory", my_pos, target_world_rot, { damage = self.stats.damage, speed = self.stats.bullet_speed })
				self.timer = self.stats.rate
			end
		end
	end


	if self.timer > 0 then
		self.timer = self.timer - dt
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") then
		if message.enter then
			self.targets_in_range[message.other_id] = true
		else
			self.targets_in_range[message.other_id] = nil
			if self.current_target == message.other_id then
				self.current_target = nil
			end
		end
	end
end