-- planet.script
local prog = require "main.progression"
local rendercam = require "rendercam.rendercam"
local registry = require "main.enemy_registry"

go.property("fire_rate", 1.1) -- Автострельба ядра: медленная, в Овердрайве в 2.2 раза быстрее

function init(self)
	msg.post(".", "acquire_input_focus")
	self.cooldown = 0
	self.manual_cooldown = 0
	self.shield_regen_delay = 0
	-- Планета неподвижна: позицию берем один раз
	self.pos = go.get_position()

	-- Начальная анимация пульсации планеты
	go.set_scale(vmath.vector3(1, 1, 1))
	go.animate(".", "scale", go.PLAYBACK_LOOP_PINGPONG, vmath.vector3(1.05, 1.05, 1), go.EASING_INOUTSINE, 2.0)

	-- Медленное вращение планеты
	go.animate(".", "euler.z", go.PLAYBACK_LOOP_FORWARD, 360, go.EASING_LINEAR, 60)
end

-- Поиск ближайшего врага строго внутри зоны действия планеты
local function get_closest_enemy(self)
	return registry.find_closest(self.pos.x, self.pos.y, prog.data.economy.planet_damage_radius or 165)
end

-- Сообщение всем живым врагам (EMP, гравитация)
local function broadcast_to_enemies(message_id, message)
	local ids = registry.all()
	for i = 1, #ids do
		msg.post(ids[i], message_id, message)
	end
end

local function apply_damage(self, amount)
	self.shield_regen_delay = 0

	local econ = prog.data.economy
	local shield = econ.shield or 0

	-- 1. Энергетический щит поглощает урон первым
	if shield > 0 then
		if shield >= amount then
			econ.shield = shield - amount
			-- Неоново-голубая вспышка щита
			go.set("#sprite", "tint", vmath.vector4(0.4, 1.0, 2.8, 1))
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_LINEAR, 0.15)
			msg.post("main:/camera_root#camera_shake", "shake", { intensity = 4, duration = 0.2 })
			msg.post("main:/gui#game", "update_planet_hp")
			return
		else
			local leftover = amount - shield
			econ.shield = 0
			econ.planet_hp = econ.planet_hp - leftover
		end
	else
		econ.planet_hp = econ.planet_hp - amount
	end

	-- Визуальный отклик (вспышка красным)
	go.set("#sprite", "tint", vmath.vector4(2.5, 0.4, 0.4, 1))
	go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_LINEAR, 0.2)

	-- Тряска камеры
	msg.post("main:/camera_root#camera_shake", "shake", { intensity = 10, duration = 0.4 })

	msg.post("main:/gui#game", "update_planet_hp")

	-- Проверка поражения
	if econ.planet_hp <= 0 then
		msg.post("main:/gui#game", "show_defeat")
	end
end

local function fire(self, target_id)
	local fire_rate_mult = prog.get_fire_rate_multiplier()
	local speed_multiplier = (1 + prog.data.click_state) * fire_rate_mult
	self.cooldown = self.fire_rate / speed_multiplier
	local my_pos = self.pos
	local tx, ty = registry.get_pos(target_id)
	local max_range = prog.data.economy.planet_damage_radius or 165

	-- Рассчитываем угол поворота к цели
	local rot = vmath.quat_rotation_z(math.atan2(ty - my_pos.y, tx - my_pos.x))

	-- Урон с учетом овердрайва
	local dmg = math.floor(prog.data.economy.planet_dmg * prog.get_damage_multiplier())
	local spd = 360 * prog.get_projectile_speed_multiplier()
	local pierce = prog.get_pierce_count()

	factory.create("#bullet_factory", my_pos, rot, {
		damage = dmg,
		speed = spd,
		pierce = pierce,
		bullet_type = hash("blaster"),
		max_range = max_range
	})
	factory.create("#bullet_out_factory", my_pos, rot)
end

function update(self, dt)
	if prog.is_paused then return end

	-- Обновление таймера Ярости (Overdrive)
	prog.update_overdrive(dt)

	-- Визуальный эффект режима Overdrive
	if prog.is_overdrive then
		self.overdrive_hue = ((self.overdrive_hue or 0) + dt * 2.0) % 1.0
		local r = 0.5 + 0.5 * math.sin(self.overdrive_hue * 6.28)
		local g = 0.8 + 0.2 * math.cos(self.overdrive_hue * 6.28)
		local b = 1.0
		go.set("#sprite", "tint", vmath.vector4(r * 2.0, g * 2.0, b * 2.0, 1.0))
	end

	-- Регенерация щита (через 3.0 сек после получения урона)
	local econ = prog.data.economy
	local max_shield = econ.shield_max or 10
	self.shield_regen_delay = (self.shield_regen_delay or 0) + dt
	if self.shield_regen_delay >= 3.0 and (econ.shield or 0) < max_shield then
		local regen_rate = math.max(3, max_shield * 0.25)
		econ.shield = math.min(max_shield, (econ.shield or 0) + regen_rate * dt)
		self.shield_sync_timer = (self.shield_sync_timer or 0) + dt
		if self.shield_sync_timer >= 0.3 or econ.shield >= max_shield then
			self.shield_sync_timer = 0
			msg.post("main:/gui#game", "update_planet_hp")
		end
	end

	-- Регенерация HP планеты
	local regen = prog.get_hp_regen()
	local max_hp = prog.get_max_hp()
	if regen > 0 and econ.planet_hp < max_hp then
		econ.planet_hp = math.min(max_hp, econ.planet_hp + regen * dt)
		self.regen_timer = (self.regen_timer or 0) + dt
		if self.regen_timer >= 0.5 then
			self.regen_timer = 0
			msg.post("main:/gui#game", "update_planet_hp")
		end
	end

	-- Управление перезарядкой
	if self.cooldown > 0 then
		self.cooldown = self.cooldown - dt
	end
	if self.manual_cooldown > 0 then
		self.manual_cooldown = self.manual_cooldown - dt
	end

	-- Hyper-Fire timer countdown
	if prog.hyper_fire_timer and prog.hyper_fire_timer > 0 then
		prog.hyper_fire_timer = prog.hyper_fire_timer - dt
	end

	-- Singularity perk: Periodically pull all enemies towards center
	if prog.data.active_upgrades["singularity"] then
		self.singularity_timer = (self.singularity_timer or 0) + dt
		if self.singularity_timer >= 9.0 then
			self.singularity_timer = 0
			factory.create("#fx_factory", self.pos)
			msg.post("main:/camera_root#camera_shake", "shake", { intensity = 6, duration = 0.3 })
			broadcast_to_enemies("gravity_pull", { strength = 60 })
		end
	end

	-- Автоматическая стрельба ядра по ближайшему врагу (подстраховка для новичков; тап сильнее).
	-- Цель ищем только когда орудие готово к выстрелу
	if self.cooldown <= 0 then
		local target = get_closest_enemy(self)
		if target then
			fire(self, target)
		end
	end
end

function on_input(self, action_id, action)
	if prog.is_paused then return end

	-- Ручной выстрел игрока по клику/тапу в направлении нажатия
	if action_id == hash("touch") and action.pressed and self.manual_cooldown <= 0 then
		self.manual_cooldown = prog.is_overdrive and 0.08 or 0.15

		local click_world = rendercam.screen_to_world_2d(action.screen_x, action.screen_y)
		local my_pos = self.pos
		local dir = click_world - my_pos
		local dist = vmath.length(dir)

		-- Кликаем в любую точку экрана
		if dist > 15 then
			local angle = math.atan2(dir.y, dir.x)
			local rot = vmath.quat_rotation_z(angle)

			local dmg = math.floor(prog.data.economy.planet_dmg * 1.5 * prog.get_damage_multiplier())
			local spd = 650 * prog.get_projectile_speed_multiplier()
			local pierce = prog.get_pierce_count()
			local aoe_radius = 45

			factory.create("#bullet_factory", my_pos, rot, {
				damage = dmg,
				speed = spd,
				pierce = pierce,
				bullet_type = hash("blaster"),
				splash_radius = aoe_radius,
				max_range = 0
			})
			factory.create("#bullet_out_factory", my_pos, rot)

			-- Накопление Ярости от каждого клика!
			prog.add_overdrive(4.0)

			-- Уведомление для системы обучения в GUI
			if msg.url("main:/gui#game") then
				msg.post("main:/gui#game", "player_tapped")
			end

			-- Сочная отдача планеты
			go.set_scale(vmath.vector3(1.1, 1.1, 1))
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1), go.EASING_OUTBACK, 0.12)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("take_damage") then
		apply_damage(self, message.amount or 10)

	elseif message_id == hash("overdrive_ended") then
		go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))

	elseif message_id == hash("revive") then
		-- Второй шанс: половина HP, полный щит и EMP по всем врагам
		local econ = prog.data.economy
		econ.planet_hp = math.floor(prog.get_max_hp() * 0.5)
		econ.shield = econ.shield_max or 0
		self.shield_regen_delay = 0
		msg.post("main:/gui#game", "update_planet_hp")
		msg.post("#", "trigger_emp")

	elseif message_id == hash("trigger_emp") then
		msg.post("main:/camera_root#camera_shake", "shake", { intensity = 14, duration = 0.5 })
		factory.create("#fx_factory", self.pos)
		broadcast_to_enemies("stun", { duration = 2.5, damage = 35 })
	end
end