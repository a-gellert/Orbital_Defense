-- station.script
-- Платформа на орбите: визуал и постройка турели. Цели турель ищет сама (turret.script).

go.property("min_alpha", 0.8)
go.property("speed", 1.0)
go.property("turret_type", hash("blaster"))

local PLATFORM_SPRITES = {
	[hash("pulse")]  = "s_green",
	[hash("rocket")] = "s_yellow",
	[hash("laser")]  = "s_purple",
	[hash("plasma")] = "s_purple",
	[hash("tesla")]  = "s_blue",
}

local TURRET_POS = vmath.vector3(0, 0, 0.1)

function init(self)
	self.turret_id = nil
	go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, self.min_alpha, go.EASING_INOUTSINE, self.speed)
end

local function build_turret(self, turret_type)
	if self.turret_id then return end
	self.turret_type = turret_type or hash("blaster")
	sprite.play_flipbook("#sprite", PLATFORM_SPRITES[self.turret_type] or "s_blue")

	-- Турель строго по центру платформы станции
	self.turret_id = factory.create("#turret_factory", TURRET_POS, nil, {
		turret_type = self.turret_type,
		level = 1
	})

	if self.turret_id then
		go.set_parent(self.turret_id, go.get_id(), false)
		go.set_position(TURRET_POS, self.turret_id)
		go.set_scale(vmath.vector3(1, 1, 1), self.turret_id)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("build_turret") then
		build_turret(self, message.turret_type or self.turret_type)
	elseif message_id == hash("build_default_turret") then
		build_turret(self, hash("blaster"))
	end
end
