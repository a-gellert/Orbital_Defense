-- station.script
go.property("min_alpha", 0.8) -- Минимальная прозрачность (80%)
go.property("speed", 1.0)     -- Время одного цикла "туда-обратно" в секундах
function init(self)
	print(">>> [STATION] Init started. ID:", go.get_id())
	go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, self.min_alpha, go.EASING_INOUTSINE, self.speed)
end

function update(self, dt)

end
function on_message(self, message_id, message, sender)
	print(">>> [STATION] Received message:", message_id)

	if message_id == hash("build_default_turret") then
		print(">>> [STATION] Command received: build_default_turret")
		-- ИСПРАВЛЕНО: вызываем как локальную функцию, передавая self первым аргументом
		build_turret(self, "blaster")
	end
end

-- Функция определена в_scope_ файла, поэтому вызывается без self:
function build_turret(self, turret_type)
	print(">>> [STATION] Attempting to create turret of type:", turret_type)

	if self.turret_id and go.exists(self.turret_id) then
		print(">>> [STATION] Warning: Turret already exists!")
		return
	end

	local target_pos = vmath.vector3(0, 0, 0.5)

	-- 1. Попытка создания
	self.turret_id = factory.create("#turret_factory", target_pos)

	-- 2. ГЛАВНАЯ ПРОВЕРКА
	if self.turret_id then
		print(">>> [STATION] SUCCESS: Turret created with ID:", self.turret_id)

		-- 3. Привязка к родителю
		go.set_parent(self.turret_id, go.get_id(), false)
		print(">>> [STATION] Turret parented to station.")

	else
		print(">>> [STATION] ERROR: factory.create returned NIL!")
		print(">>> [STATION] Check if '#turret_factory' exists in the SAME collection as station.")
	end
end