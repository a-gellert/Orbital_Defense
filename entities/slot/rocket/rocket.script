-- rocket.script
local prog = require "main.progression"
local registry = require "main.enemy_registry"

go.property("damage", 0)
go.property("speed", 300)
go.property("target_id", hash(""))

local FORWARD = vmath.vector3(1, 0, 0)
local TURN_RATE = 0.14       -- доля поворота к цели за кадр
local RETARGET_RANGE = 200   -- если цель погибла, ракета ищет новую в этом радиусе
local SPLASH_RADIUS = 55

function init(self)
	self.life = 4.0
	local pos = go.get_position()
	go.set_position(vmath.vector3(pos.x, pos.y, 0.4))
end

function update(self, dt)
	if prog.is_paused then return end

	self.life = self.life - dt
	if self.life <= 0 then
		go.delete()
		return
	end

	local my_pos = go.get_position()
	if not registry.has(self.target_id) then
		self.target_id = registry.find_closest(my_pos.x, my_pos.y, RETARGET_RANGE) or hash("")
	end

	local tx, ty = registry.get_pos(self.target_id)
	local current_dir = vmath.rotate(go.get_rotation(), FORWARD)
	if tx then
		-- Плавный поворот к цели
		local target_dir = vmath.normalize(vmath.vector3(tx - my_pos.x, ty - my_pos.y, 0))
		current_dir = vmath.lerp(TURN_RATE, current_dir, target_dir)
		go.set_rotation(vmath.quat_rotation_z(math.atan2(current_dir.y, current_dir.x)))
	end

	go.set_position(my_pos + vmath.normalize(current_dir) * self.speed * dt)
end

function on_message(self, message_id, message, sender)
	-- Ракета (kinematic) и враг (trigger) дают trigger_response, а не collision_response
	local is_hit = message_id == hash("collision_response")
		or (message_id == hash("trigger_response") and message.enter)
	if not is_hit or self.exploded then return end
	self.exploded = true

	local hit_enemy = message.other_id
	local my_pos = go.get_world_position()
	msg.post(hit_enemy, "take_damage", { amount = self.damage })

	-- Сплеш-урон по площади
	local radius = SPLASH_RADIUS * prog.get_splash_radius_mult()
	local area_damage = math.max(1, math.floor(self.damage * 0.6))
	local targets = registry.query_radius(my_pos.x, my_pos.y, radius, hit_enemy)
	for i = 1, #targets do
		msg.post(targets[i], "take_damage", { amount = area_damage })
	end

	msg.post("main:/camera_root#camera_shake", "shake", { intensity = 6, duration = 0.22 })
	go.delete()
end
