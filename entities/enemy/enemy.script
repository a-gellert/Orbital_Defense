-- enemy.script
local prog = require "main.progression"
local config = require "main.game_config" -- Убедись, что твои таблицы статов лежат тут

go.property("type", hash("kamikaze"))
go.property("hp_multiplier", 1.0)
go.property("reward_multiplier", 1.0)
go.property("is_boss", false)

-- Хеши для быстрого сравнения
local types = {
	KAMIKAZE = hash("kamikaze"),
	SWARMER = hash("swarmer"),
	SWING = hash("swing"),
	SHOOTER = hash("shooter"),
	TANK = hash("tank"),
	SPLITTER = hash("splitter"),
	MINI_SPLITTER = hash("mini_splitter"),
	WARP = hash("warp")
}

local function play_hit_animation(self)
	-- Сочный Squash & Stretch
	go.set_scale(vmath.vector3(1.35, 0.7, 1))
	go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1), go.EASING_OUTELASTIC, 0.22)

	-- Ослепительная неоновая вспышка
	go.set("#sprite", "tint", vmath.vector4(2.5, 2.5, 2.5, 1)) 
	go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.12)
end

local function die(self, was_killed_by_player)
	if self.is_dead then return end
	self.is_dead = true
	prog.active_enemies[go.get_id()] = nil

	-- Если это Сплиттер, спавним мелких
	if self.type == types.SPLITTER and was_killed_by_player then
		for i = 1, 3 do
			local offset = vmath.vector3(math.random(-20, 20), math.random(-20, 20), 0)
			factory.create("#enemy_factory", go.get_position() + offset, nil, { type = types.MINI_SPLITTER })
		end
	end

	msg.post("/enemy_manager", "enemy_died")

	if not was_killed_by_player then
		-- Наносим прямой урон планете, если враг долетел
		msg.post("main:/planet#planet", "take_damage", { amount = self.stats.damage or 10 })
	end

	local intensity = self.is_boss and 16 or ((self.stats and self.stats.hp and self.stats.hp > 25) and 7 or 4)
	local duration = self.is_boss and 0.6 or 0.25
	msg.post("main:/camera_root#camera_shake", "shake", { intensity = intensity, duration = duration })

	factory.create("#fx_factory", go.get_position())
	go.delete() 
end

function final(self)
	prog.active_enemies[go.get_id()] = nil
end

function init(self)
	prog.active_enemies[go.get_id()] = true
	self.target_pos = vmath.vector3(0, 0, 0)
	self.is_dead = false
	self.sin_timer = 0
	self.warp_timer = 0
	self.base_pos = go.get_position()
	self.ghost_timer = 0
	-- 1. Получаем таблицу статов
	local raw_stats = config.enemy_stats
	self.stats = nil

	-- 2. Ищем данные врага по хешу типа
	for name, data in pairs(raw_stats) do
		if hash(name) == self.type then
			self.stats = data
			self.type_name = name
			break
		end
	end

	-- 3. ПРОВЕРКА: Если тип не найден, ставим дефолтные статы
	if not self.stats then
		print("ERROR: Enemy type not found in config: " .. tostring(self.type))
		self.stats = { hp = 10, damage = 5, speed = 50, move = "straight", shield = 0 }
		self.type_name = "kamikaze"
	end

	-- 4. Задаем здоровье с учетом множителя волны
	local base_hp = self.stats.hp or 10
	self.health = math.max(1, math.floor(base_hp * (self.hp_multiplier or 1.0)))
	self.max_health = self.health

	-- Ставим спрайт
	sprite.play_flipbook("#sprite", hash(self.type_name))

	-- Босс: увеличенный масштаб и зловещий красный неон
	if self.is_boss then
		go.set_scale(vmath.vector3(1.7, 1.7, 1))
		go.set("#sprite", "tint", vmath.vector4(2.2, 0.4, 0.4, 1))
	end

	self.shoot_timer = self.stats.is_fireable and 2.0 or 0
end
function update(self, dt)
	if self.is_dead or prog.is_paused then return end

	local my_pos = go.get_position()
	local to_target = self.target_pos - my_pos
	local dist = vmath.length(to_target)
	local dir = dist > 0.1 and vmath.normalize(to_target) or vmath.vector3(1,0,0)

	-- ЛОГИКА ДВИЖЕНИЯ
	if self.stats.move == "straight" then
		local stop_dist = self.stats.is_fireable and 75 or 20
		if dist > stop_dist then
			go.set_position(my_pos + dir * self.stats.speed * dt)
		end
	elseif self.stats.move == "sinuos" then
		self.sin_timer = self.sin_timer + dt
		local side_dir = vmath.vector3(-dir.y, dir.x, 0)
		local wave = math.sin(self.sin_timer * 3) * 60
		self.base_pos = self.base_pos + dir * self.stats.speed * dt
		go.set_position(self.base_pos + side_dir * wave)
	elseif self.stats.move == "warp" then
		self.warp_timer = self.warp_timer + dt
		if self.warp_timer > 2.5 then
			go.set_position(my_pos + dir * 60) -- Прыжок
			self.warp_timer = 0
			factory.create("#fx_factory", my_pos) -- Эффект вспышки на месте прыжка
		end
		go.set_position(go.get_position() + dir * self.stats.speed * dt)
	end

	-- ПОВОРОТ К ЦЕНТРУ
	go.set_rotation(vmath.quat_rotation_z(math.atan2(dir.y, dir.x)))

	-- СТРЕЛЬБА
	if self.stats.is_fireable then
		self.shoot_timer = self.shoot_timer - dt
		if self.shoot_timer <= 0 and dist < 100 then
			factory.create("#bullet_factory", my_pos, go.get_rotation(), { is_enemy = true, damage = self.stats.damage })
			self.shoot_timer = 2.5
		end
	end
	self.ghost_timer = self.ghost_timer + dt
	if self.ghost_timer > 0.1 then
		self.ghost_timer = 0

		-- Спавним госта в текущей позиции врага
		local ghost_id = factory.create("#ghost_factory", go.get_position(), go.get_rotation())

		-- Настраиваем его внешний вид (тот же спрайт и тинт)
		local sprite_url = msg.url(nil, ghost_id, "sprite")
		sprite.play_flipbook(sprite_url, hash(self.type_name))

		-- Анимация исчезновения и удаления
		go.set(sprite_url, "tint", vmath.vector4(1, 1, 1, 0.4)) -- Полупрозрачный
		go.animate(sprite_url, "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.4, 0, function()
			go.delete(ghost_id)
		end)
	end
	-- ПРОВЕРКА СТОЛКНОВЕНИЯ
	if dist < 25 then
		die(self, false)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("take_damage") then
		-- Учет щита: щит поглощает часть урона
		local effective_damage = message.amount / (1 + (self.stats.shield or 0))
		self.health = self.health - effective_damage

		-- Физическая отдача (Knockback от центра планеты)
		local my_pos = go.get_position()
		local dist_sq = my_pos.x * my_pos.x + my_pos.y * my_pos.y
		if dist_sq > 25 then
			local dist = math.sqrt(dist_sq)
			local push_dir = vmath.vector3(my_pos.x / dist, my_pos.y / dist, 0)
			local knockback = (self.stats.shield and self.stats.shield > 0) and 7 or 18
			go.set_position(my_pos + push_dir * knockback)
		end

		factory.create("#damage_factory", go.get_position() + vmath.vector3(0, 0, 0.7), nil, { value = math.floor(effective_damage) })

		play_hit_animation(self)

		if self.health <= 0 and not self.is_dead then
			local reward = math.max(1, math.floor(prog.get_gold_per_kill() * (self.reward_multiplier or 1.0)))
			msg.post("main:/logic#game_manager", "enemy_killed", { amount = reward })
			prog.add_overdrive(4)
			die(self, true)
		end
	end
end