-- enemy.script
local prog = require "main.progression"

go.property("type", hash("kamikaze"))
go.property("health", 20)
go.property("max_health", 20)
local types = {
	KAMIKAZE = hash("kamikaze"),
	SHOOTER = hash("shooter"),
	SINUOUS = hash("sinuous")
}
-- Внутри логики смерти врага
function die(self)
	-- Отправляем в спавнер (чтобы он считал живых)
	msg.post("/enemy_manager", "enemy_died")
	msg.post("@render:", "player_take_damage", { amount = 10 })

	msg.post("main:/camera_root#camera_shake", "shake", { intensity = 4, duration = 0.2 })
	timer.delay(0.1, false, function()
		factory.create("#fx_factory", go.get_position())
		go.delete() 
	end)
end
function play_hit_animation(self)
	-- 1. Сбросим масштаб в 1, если предыдущая анимация еще шла
	go.set_scale(vmath.vector3(1, 1, 1))

	-- 2. Цепочка анимаций:
	-- Сначала сжимаем (0.05 сек)
	go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.8, 0.8, 1), go.EASING_OUTCUBIC, 0.07, 0, function()
		-- Затем раздуваем чуть больше нормы (0.07 сек)
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.2, 1.2, 1), go.EASING_OUTBACK, 0.1, 0, function()
			-- Возвращаем в исходный размер (0.05 сек)
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1, 1, 1), go.EASING_INSINE, 0.05)
		end)
	end)

	-- Дополнительно: можно "мигнуть" красным цветом, если у тебя стоит спрайт
	go.set("#sprite", "tint", vmath.vector4(2, 0.5, 0.5, 1)) -- Усиливаем красный канал
	go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_INSINE, 0.2)
end
function init(self)
	self.target_pos = vmath.vector3(0, 0, 0)
	self.speed = 10
	self.shoot_timer = 0
	self.sin_timer = 0
	self.base_pos = nil
	self.is_dead = false
	self.reward = 3
	
	-- Настройка типа
	if self.type == types.KAMIKAZE then
		self.speed = 90
		self.health = 10
	elseif self.type == types.SHOOTER then
		self.speed = 60
		self.stop_distance = 150
		self.health = 40
		self.shoot_timer = 2.0 -- Задержка перед первым выстрелом
	elseif self.type == types.SINUOUS then
		self.speed = 70
		self.amplitude = 60
		self.frequency = 3
		self.health = 30
	end

	self.max_health = self.health
end

function update(self, dt)
	if self.is_dead then return end
	if prog.is_paused then return end
	
	local my_pos = go.get_position()
	local to_target = self.target_pos - my_pos
	local dist = vmath.length(to_target)
	local dir = dist > 0.1 and vmath.normalize(to_target) or vmath.vector3(1,0,0)
	if self.type == types.SHOOTER then
		-- Движение
		if dist > self.stop_distance then
			go.set_position(my_pos + dir * self.speed * dt)
		end
		go.set_rotation(vmath.quat_rotation_z(math.atan2(dir.y, dir.x)))

		-- Стрельба
		self.shoot_timer = self.shoot_timer - dt
		if self.shoot_timer <= 0 then
			-- Стреляем только если враг в радиусе атаки
			if dist <= self.stop_distance + 50 then 
				factory.create("#bullet_factory", my_pos, go.get_rotation(), {
					is_enemy = true,
					damage = 10,
					speed = 300
				})
				self.shoot_timer = 2.0 -- Перезарядка
			else
				self.shoot_timer = 0.5
			end
		end

	elseif self.type == types.SINUOUS then
		self.sin_timer = self.sin_timer + dt
		local side_dir = vmath.vector3(-dir.y, dir.x, 0)
		local offset = side_dir * math.sin(self.sin_timer * self.frequency) * self.amplitude
		self.base_pos = (self.base_pos or my_pos) + dir * self.speed * dt
		go.set_position(self.base_pos + offset)
		go.set_rotation(vmath.quat_rotation_z(math.atan2(dir.y, dir.x)))
	elseif self.type == types.KAMIKAZE then
		go.set_position(my_pos + dir * self.speed * dt)
		go.set_rotation(vmath.quat_rotation_z(math.atan2(dir.y, dir.x)))
	end

	-- Проверка столкновения с центром
	if dist < 20 then
		die(self)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("take_damage") then
		self.health = self.health - message.amount
		local p = go.get_position()
		-- Добавляем немного Z, чтобы цифры были ПОВЕРХ врагов
		p.z = 0.7
		factory.create("#damage_factory", p, nil, { value = message.amount })
		-- Визуал удара
		go.cancel_animations("#sprite", "tint")
		go.set("#sprite", "tint", vmath.vector4(1, 0.5, 0.5, 1))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.3)
		play_hit_animation(self)
		if self.health <= 0 and not self.is_dead then
			self.is_dead = true
			msg.post("main:/logic#game_manager", "enemy_killed", { amount = prog.data.economy.gold_per_kill })
			die(self)
		end
	end
	if message_id == hash("die_from_crash") then
		-- Враг умирает, но НЕ дает золото, так как он нанес урон планете

		msg.post("/enemy_manager", "enemy_died") 
		go.delete()
	end
end

