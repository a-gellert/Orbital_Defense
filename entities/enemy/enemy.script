-- enemy.script
local prog = require "main.progression"
local config = require "main.game_config"

go.property("type", hash("kamikaze"))
go.property("hp_multiplier", 1.0)
go.property("reward_multiplier", 1.0)
go.property("is_boss", false)

local types = {
	KAMIKAZE      = hash("kamikaze"),
	SWARMER       = hash("swarmer"),
	SWING         = hash("swing"),
	SHOOTER       = hash("shooter"),
	TANK          = hash("tank"),
	SPLITTER      = hash("splitter"),
	MINI_SPLITTER = hash("mini_splitter"),
	WARP          = hash("warp"),
	SPEEDER       = hash("speeder"),
	GHOST         = hash("ghost"),
	SHIELD_BEARER = hash("shield_bearer"),
	DREADNOUGHT   = hash("dreadnought"),
	GOLD_ASTEROID = hash("gold_asteroid")
}

local function play_hit_animation(self, has_shield)
	-- Сочный Squash & Stretch
	go.set_scale(vmath.vector3(1.35, 0.7, 1))
	go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, self.base_scale or vmath.vector3(1.0, 1.0, 1), go.EASING_OUTELASTIC, 0.22)

	-- Вспышка: неоново-голубая если щит поглотил урон, иначе ослепительно-белая
	if has_shield then
		go.set("#sprite", "tint", vmath.vector4(0.4, 1.8, 3.0, 1)) 
	else
		go.set("#sprite", "tint", vmath.vector4(2.5, 2.5, 2.5, 1)) 
	end
	go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.default_tint or vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.14)
end

local function die(self, was_killed_by_player)
	if self.is_dead then return end
	self.is_dead = true
	prog.active_enemies[go.get_id()] = nil

	if self.is_asteroid then
		if was_killed_by_player then
			local my_pos = go.get_position()
			factory.create("#fx_factory", my_pos)
			msg.post("main:/camera_root#camera_shake", "shake", { intensity = 9, duration = 0.35 })
			local reward = math.random(60, 100)
			if msg.url("main:/gui#game") then
				msg.post("main:/gui#game", "asteroid_destroyed", { pos = my_pos, amount = reward })
			end
		end
		go.delete()
		return
	end

	-- Если это Сплиттер, спавним 3 мелких осколка
	if self.type == types.SPLITTER and was_killed_by_player then
		for i = 1, 3 do
			local offset = vmath.vector3(math.random(-25, 25), math.random(-25, 25), 0)
			factory.create("#enemy_factory", go.get_position() + offset, nil, { 
				type = types.MINI_SPLITTER,
				hp_multiplier = self.hp_multiplier or 1.0,
				reward_multiplier = self.reward_multiplier or 1.0
			})
		end
	end

	msg.post("/enemy_manager", "enemy_died")

	-- Chain Reaction perk: Corpse Explosion
	if was_killed_by_player and prog.data.active_upgrades["chain_reaction"] then
		local my_pos = go.get_position()
		local blast_dmg = math.max(6, math.floor(self.max_health * 0.4))
		local blast_radius = 50
		factory.create("#fx_factory", my_pos)
		for enemy_id, _ in pairs(prog.active_enemies) do
			if enemy_id ~= go.get_id() and go.exists(enemy_id) then
				local e_pos = go.get_position(enemy_id)
				if vmath.length(e_pos - my_pos) <= blast_radius then
					msg.post(enemy_id, "take_damage", { amount = blast_dmg })
				end
			end
		end
	end

	if not was_killed_by_player then
		-- Прямой урон планете при столкновении
		msg.post("main:/planet#planet", "take_damage", { amount = self.stats.damage or 10 })
	end

	local intensity = self.is_boss and 18 or ((self.stats and self.stats.hp and self.stats.hp >= 50) and 9 or 4)
	local duration = self.is_boss and 0.65 or 0.25
	msg.post("main:/camera_root#camera_shake", "shake", { intensity = intensity, duration = duration })

	factory.create("#fx_factory", go.get_position())
	go.delete() 
end

function final(self)
	prog.active_enemies[go.get_id()] = nil
end

function init(self)
	prog.active_enemies[go.get_id()] = true
	self.target_pos = vmath.vector3(0, 0, 0)
	self.is_dead = false
	self.sin_timer = 0
	self.warp_timer = 0
	self.speeder_timer = 0
	self.ghost_phase_timer = 0
	self.ghost_trail_timer = 0
	self.base_pos = go.get_position()

	-- 1. Получаем таблицу статов
	local raw_stats = config.enemy_stats
	self.stats = nil

	for name, data in pairs(raw_stats) do
		if hash(name) == self.type then
			self.stats = data
			self.type_name = name
			break
		end
	end

	if not self.stats then
		self.stats = { hp = 14, damage = 10, speed = 34, move = "straight", shield = 0 }
		self.type_name = "kamikaze"
	end

	-- 2. Задаем здоровье с учетом множителя волны
	local base_hp = self.stats.hp or 10
	self.health = math.max(1, math.floor(base_hp * (self.hp_multiplier or 1.0)))
	self.max_health = self.health
	self.current_shield = self.stats.shield or 0

	-- 3. Спрайт
	sprite.play_flipbook("#sprite", hash(self.type_name))

	self.base_scale = vmath.vector3(1.0, 1.0, 1.0)
	self.default_tint = vmath.vector4(1, 1, 1, 1)

	if self.is_boss then
		self.base_scale = vmath.vector3(1.8, 1.8, 1)
		self.default_tint = vmath.vector4(2.2, 0.4, 0.4, 1)
		go.set_scale(self.base_scale)
		go.set("#sprite", "tint", self.default_tint)
	elseif self.type == types.DREADNOUGHT then
		self.base_scale = vmath.vector3(1.4, 1.4, 1)
		go.set_scale(self.base_scale)
	elseif self.type == types.MINI_SPLITTER then
		self.base_scale = vmath.vector3(0.7, 0.7, 1)
		go.set_scale(self.base_scale)
	elseif self.type == types.GOLD_ASTEROID then
		self.base_scale = vmath.vector3(0.24, 0.24, 1)
		self.is_asteroid = true
		self.rot_speed = math.random(-35, 35)
		go.set_scale(self.base_scale)
		go.set("#sprite", "tint", vmath.vector4(1.4, 1.2, 0.4, 1))
	end

	self.shoot_timer = self.stats.is_fireable and 1.8 or 0
end

function update(self, dt)
	if self.is_dead or prog.is_paused then return end

	local my_pos = go.get_position()

	-- ЛОГИКА ДВИЖЕНИЯ ЗОЛОТОГО АСТЕРОИДА (плавный дрифт и вращение)
	if self.is_asteroid or (self.stats and self.stats.move == "drift") then
		local dir = self.drift_dir or vmath.vector3(1, 0, 0)
		local current_speed = self.stats and self.stats.speed or 32
		go.set_position(my_pos + dir * current_speed * dt)
		go.set_rotation(go.get_rotation() * vmath.quat_rotation_z(math.rad((self.rot_speed or 25) * dt)))

		if math.abs(my_pos.x) > 260 or math.abs(my_pos.y) > 460 then
			die(self, false)
		end
		return
	end

	local to_target = self.target_pos - my_pos
	local dist = vmath.length(to_target)
	local dir = dist > 0.1 and vmath.normalize(to_target) or vmath.vector3(1, 0, 0)

	local current_speed = self.stats.speed

	-- Slow & Stun debuffs
	if self.slow_timer and self.slow_timer > 0 then
		self.slow_timer = self.slow_timer - dt
		current_speed = current_speed * (self.slow_factor or 0.55)
	end
	if self.stun_timer and self.stun_timer > 0 then
		self.stun_timer = self.stun_timer - dt
		current_speed = 0
	end

	-- ЛОГИКА ДВИЖЕНИЯ
	if self.stats.move == "straight" then
		local stop_dist = self.stats.is_fireable and 80 or 20
		if dist > stop_dist then
			go.set_position(my_pos + dir * current_speed * dt)
		end

	elseif self.stats.move == "sinuos" then
		self.sin_timer = self.sin_timer + dt
		local side_dir = vmath.vector3(-dir.y, dir.x, 0)
		local wave = math.sin(self.sin_timer * 3.5) * 65
		self.base_pos = self.base_pos + dir * current_speed * dt
		go.set_position(self.base_pos + side_dir * wave)

	elseif self.stats.move == "warp" then
		self.warp_timer = self.warp_timer + dt
		if self.warp_timer > 2.2 then
			self.warp_timer = 0
			local jump_dist = math.min(dist - 30, 75)
			if jump_dist > 15 then
				factory.create("#fx_factory", my_pos)
				go.set_position(my_pos + dir * jump_dist)
			end
		end
		go.set_position(go.get_position() + dir * current_speed * dt)

	elseif self.stats.move == "speeder" then
		self.speeder_timer = self.speeder_timer + dt
		-- Рывковое ускорение
		local surge = 1.0 + 0.6 * math.sin(self.speeder_timer * 4.0)
		go.set_position(my_pos + dir * (current_speed * surge) * dt)

	elseif self.stats.move == "ghost" then
		self.ghost_phase_timer = self.ghost_phase_timer + dt
		-- Пульсирующая полупрозрачность спектрального призрака
		local alpha = 0.35 + 0.55 * math.abs(math.sin(self.ghost_phase_timer * 2.5))
		go.set("#sprite", "tint.w", alpha)
		go.set_position(my_pos + dir * current_speed * dt)
	end

	-- ПОВОРОТ К ПЛАНЕТЕ
	go.set_rotation(vmath.quat_rotation_z(math.atan2(dir.y, dir.x)))

	-- СТРЕЛЬБА ДЛЯ СТРЕЛКОВ И ДРЕДНОУТОВ
	if self.stats.is_fireable then
		self.shoot_timer = self.shoot_timer - dt
		if self.shoot_timer <= 0 and dist < 120 then
			factory.create("#bullet_factory", my_pos, go.get_rotation(), { is_enemy = true, damage = self.stats.damage })
			if self.type == types.DREADNOUGHT then
				-- Второй выстрел со смещением
				local side = vmath.vector3(-dir.y, dir.x, 0) * 12
				factory.create("#bullet_factory", my_pos + side, go.get_rotation(), { is_enemy = true, damage = self.stats.damage })
			end
			self.shoot_timer = (self.type == types.DREADNOUGHT) and 2.2 or 2.6
		end
	end

	-- ТРЕЙЛ / ПОСЛЕСВЕЧЕНИЕ ДЛЯ БЫСТРЫХ И ОСОБЫХ ВРАГОВ
	local should_trail = (self.is_boss or self.stats.move == "speeder" or self.stats.move == "ghost" or self.stats.move == "warp")
	if should_trail then
		self.ghost_trail_timer = self.ghost_trail_timer + dt
		if self.ghost_trail_timer > 0.14 then
			self.ghost_trail_timer = 0
			local ghost_id = factory.create("#ghost_factory", go.get_position(), go.get_rotation())
			local sprite_url = msg.url(nil, ghost_id, "sprite")
			sprite.play_flipbook(sprite_url, hash(self.type_name))
			go.set_scale(self.base_scale or vmath.vector3(1, 1, 1), ghost_id)
			go.set(sprite_url, "tint", vmath.vector4(1, 1, 1, 0.35))
			go.animate(sprite_url, "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.35, 0, function()
				go.delete(ghost_id)
			end)
		end
	end

	-- СТОЛКНОВЕНИЕ С ПОВЕРХНОСТЬЮ ПЛАНЕТЫ
	if dist < 25 then
		die(self, false)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("take_damage") then
		local has_shield = (self.current_shield and self.current_shield > 0)
		local effective_damage = message.amount / (1 + (self.current_shield or 0) * 0.4)
		self.health = self.health - effective_damage

		-- Физический нокбэк от ядра
		local my_pos = go.get_position()
		local dist_sq = my_pos.x * my_pos.x + my_pos.y * my_pos.y
		if dist_sq > 25 then
			local dist = math.sqrt(dist_sq)
			local push_dir = vmath.vector3(my_pos.x / dist, my_pos.y / dist, 0)
			local knockback = has_shield and 6 or 16
			go.set_position(my_pos + push_dir * knockback)
		end

		factory.create("#damage_factory", go.get_position() + vmath.vector3(0, 0, 0.7), nil, { value = math.floor(effective_damage) })

		play_hit_animation(self, has_shield)

		-- Cryo slow synergy
		if prog.data.active_upgrades["cryo_rounds"] then
			self.slow_timer = 2.5
			self.slow_factor = 0.55
			go.set("#sprite", "tint", vmath.vector4(0.35, 0.85, 2.5, 1))
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.default_tint or vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.45)
		end

		if self.health <= 0 and not self.is_dead then
			if not self.is_asteroid then
				local reward = math.max(1, math.floor(prog.get_gold_per_kill() * (self.reward_multiplier or 1.0)))
				msg.post("main:/logic#game_manager", "enemy_killed", { amount = reward })
				prog.add_overdrive(4)
			end
			die(self, true)
		end

	elseif message_id == hash("stun") then
		self.stun_timer = message.duration or 2.5
		if message.damage and message.damage > 0 then
			msg.post(msg.url(), "take_damage", { amount = message.damage })
		end
		go.set("#sprite", "tint", vmath.vector4(3.0, 3.0, 0.5, 1))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, self.default_tint or vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.3)

	elseif message_id == hash("gravity_pull") then
		local my_pos = go.get_position()
		local dist = vmath.length(my_pos)
		if dist > 35 then
			local dir = vmath.normalize(-my_pos)
			local pull = math.min(message.strength or 55, dist - 30)
			go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, my_pos + dir * pull, go.EASING_OUTQUAD, 0.35)
		end
	end
end