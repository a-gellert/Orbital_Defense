local prog = require "main.progression"

local DECAY_SPEED = 0.2
local CLICK_POWER = 0.1 

local function update_visual_range_go(self)
	local texture_diameter = 512 
	local scale_factor = (prog.data.economy.planet_damage_radius * 2) / texture_diameter
	-- Масштабируем основной объект (родитель)
	go.set_scale(vmath.vector3(scale_factor, scale_factor, 1), ".")
end

function init(self)
	self.charge = 0
	-- Цвет внешнего круга
	go.set("#sprite", "tint", vmath.vector4(0.7, 0.4, 0.4, 0.2))

	-- Цвет внутреннего круга (обращаемся к дочернему объекту по ID)
	-- Используем относительный путь "fill_circle", если он ребенок этого объекта
	go.set("fill_circle#sprite", "tint", vmath.vector4(1, 0.3, 0.3, 0.5))

	msg.post(".", "acquire_input_focus")
	update_visual_range_go(self)
end

function update(self, dt)
	if prog.is_paused then return end

	if self.charge > 0 then
		self.charge = math.max(0, self.charge - DECAY_SPEED * dt)
		prog.data.click_state = self.charge
	end

	-- Масштабируем ОБЪЕКТ fill_circle, а не его спрайт
	local fill_scale = math.max(0.001, self.charge)
	go.set_scale(vmath.vector3(fill_scale, fill_scale, 1), "fill_circle")

	if self.charge > 0.2 then
		local shake_amount = self.charge * 4 
		msg.post("main:/camera_root#camera_shake", "shake", { intensity = shake_amount, duration = 0.1 })
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		self.charge = math.min(1, self.charge + CLICK_POWER)
		prog.data.click_state = self.charge
		-- Анимируем масштаб объекта fill_circle
		go.cancel_animations("fill_circle", "scale")

		-- Импульс при клике (чуть больше текущего заряда)
		local pulse_scale = math.min(1.1, self.charge + 0.05)
		go.set_scale(vmath.vector3(pulse_scale, pulse_scale, 1), "fill_circle")

		-- Возвращаем к честному значению заряда
		go.animate("fill_circle", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(self.charge, self.charge, 1), go.EASING_OUTQUAD, 0.1)

		return true
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("planet_stats_updated") then
		update_visual_range_go(self)
	end
end