local rendercam = require "rendercam.rendercam"
local prog = require "main.progression" 

--- 1. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---

-- Утилита для подсчета элементов в хэш-таблице
local function table_size(t)
	local count = 0
	for _ in pairs(t) do count = count + 1 end
	return count
end

-- Привязка к родителю
local function set_parent(child, parent_id)
	msg.post(child, "set_parent", { parent_id = parent_id, keep_world_transform = 0 })
end

-- Расчет позиции слота на круге
local function get_slot_position(radius, index, total_slots)
	local angle = (2 * math.pi / total_slots) * (index - 1)
	return vmath.vector3(radius * math.cos(angle), radius * math.sin(angle), 0)
end

-- Создание всех слотов для конкретной орбиты
local function spawn_orbit_slots(self, key, orbit)
	-- Запускаем вращение визуального объекта орбиты
	go.animate(orbit.id, "euler.z", go.PLAYBACK_LOOP_FORWARD, 360, go.EASING_LINEAR, 10 / orbit.speed)

	for i = 1, orbit.slots do
		local pos = get_slot_position(orbit.radius, i, orbit.slots)
		local slot_id = factory.create("#slot_factory", pos, nil, {}, 0.5)

		if slot_id then
			set_parent(slot_id, orbit.id)
			self.slot_map[slot_id] = { 
				orbit_key = key, 
				slot_index = i, 
				occupied = false,
				orbit_id = orbit.id
			}
		end
	end
	print("🪐 Orbit Initialized:", key, "Slots spawned:", orbit.slots)
end

--- 2. ЛОГИКА РАЗМЕЩЕНИЯ ---

-- Поиск первого свободного слота среди всех купленных орбит
local function find_free_slot(self)
	for slot_id, data in pairs(self.slot_map) do
		if not data.occupied then
			return slot_id, data
		end
	end
	return nil, nil
end

-- Установка станции (визуальный блок + логика турели)
local function place_station(self, slot_id, slot_data, turret_type)
	if not slot_id or not go.exists(slot_id) then return false end

	local local_pos = go.get_position(slot_id)
	local orbit_id = slot_data.orbit_id

	-- Создаем объект станции
	local station_id = factory.create("#station_factory", nil, nil, {
		turret_type = hash(turret_type),
		level = 1
	})

	if station_id then
		-- Привязываем к орбите, чтобы станция вращалась вместе с ней
		msg.post(station_id, "set_parent", { parent_id = orbit_id, keep_world_transform = 0 })
		go.set_position(local_pos, station_id)

		slot_data.occupied = true
		msg.post(slot_id, "occupy_slot", { turret_id = station_id })
		-- Команда самой станции начать строить турель внутри себя
		msg.post(station_id, "build_turret", { turret_type = hash(turret_type) })
		return true
	end
end

--- 3. СИСТЕМНЫЕ ФУНКЦИИ ---

function init(self)
	msg.post(".", "acquire_input_focus")
	self.slot_map = {}
	self.pending_turret = nil

	-- Создаем слоты только для тех орбит, которые уже разблокированы в progression.lua
	for key, orbit in pairs(prog.data.orbits_data) do
		if orbit.unlocked then
			spawn_orbit_slots(self, key, orbit)
		end
	end

	print("✅ Orbit Controller Ready. Active slots:", table_size(self.slot_map))
end

function on_message(self, message_id, message, sender)
	-- Покупка ТУРЕЛИ
	if message_id == hash("upgrade_purchased") then
		local slot_id, slot_data = find_free_slot(self)
		if slot_id then
			place_station(self, slot_id, slot_data, message.id)
			msg.post("main:/gui#game", "turret_spawned", { success = true })
		else
			print("⚠️ No free slots available!")
			msg.post("main:/gui#game", "turret_spawned", { success = false })
		end

		-- Покупка ОРБИТЫ (активация нового круга)
	elseif message_id == hash("unlock_orbit") then
		local key = message.key
		local orbit = prog.data.orbits_data[key]
		if orbit and not orbit.unlocked then
			orbit.unlocked = true
			spawn_orbit_slots(self, key, orbit)
		end
	end
end

function on_input(self, action_id, action)
	-- Логика ручной установки через тач (если есть выбранная турель)
	if action_id == hash("touch") and action.pressed then
		local world_pos = rendercam.screen_to_world_2d(action.screen_x, action.screen_y)
		for slot_id, data in pairs(self.slot_map) do
			if not data.occupied then
				local slot_world_pos = go.get_world_position(slot_id)
				-- Если кликнули достаточно близко к слоту (радиус 40)
				if vmath.length(slot_world_pos - world_pos) < 40 then
					if self.pending_turret then
						place_station(self, slot_id, data, self.pending_turret)
						self.pending_turret = nil
					end
					break
				end
			end
		end
	end
end