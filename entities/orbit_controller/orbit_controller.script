local rendercam = require "rendercam.rendercam"

-- Настройки орбит
local ORBITS = {
	inner =  { id = hash("/orbit_inner"),  radius = 100, speed = 1.0, slots = 4 },
	middle = { id = hash("/orbit_middle"), radius = 150, speed = 0.6, slots = 6 },
	outer =  { id = hash("/orbit_outer"),  radius = 200, speed = 0.3, slots = 8 }
}

-- Вспомогательная функция (чтобы не писать msg.post каждый раз)
local function set_parent(child, parent_id)
	msg.post(child, "set_parent", { parent_id = parent_id, keep_world_transform = 0 })
end

local function get_slot_position(radius, index, total_slots)
	local angle = (2 * math.pi / total_slots) * (index - 1)
	return vmath.vector3(radius * math.cos(angle), radius * math.sin(angle), 0)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.slot_map = {}

	for key, orbit in pairs(ORBITS) do
		-- Вращение орбиты
		go.animate(orbit.id, "euler.z", go.PLAYBACK_LOOP_FORWARD, 360, go.EASING_LINEAR, 10 / orbit.speed)

		for i = 1, orbit.slots do
			local pos = get_slot_position(orbit.radius, i, orbit.slots)
			-- Создаем слот
			local slot_id = factory.create("#slot_factory", pos, nil, {}, 0.5)

			-- Привязываем слот к орбите
			set_parent(slot_id, orbit.id)

			self.slot_map[slot_id] = { orbit_key = key, slot_index = i, occupied = false }
		end
	end
end
-- ... (начало файла без изменений) ...

local function place_station(self, slot_id)
	local slot_data = self.slot_map[slot_id]

	if slot_data and not slot_data.occupied then
		local pos = go.get_position(slot_id)
		local orbit_hash = ORBITS[slot_data.orbit_key].id

		-- 1. Создаем Станцию
		local station_id = factory.create("#station_factory", pos)

		if station_id then
			-- 2. Привязываем Станцию к Орбите (асинхронно)
			set_parent(station_id, orbit_hash)

			-- 3. Отправляем сообщение на постройку турели
			-- Теперь station.script имеет on_message и обработает это
			msg.post(station_id, "build_default_turret")

			slot_data.occupied = true
			print("Station placed on orbit: " .. slot_data.orbit_key)
		else
			print("ERROR: Failed to create station!")
		end
	end
end

-- ... (остальной код без изменений) ...

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		local world_pos = rendercam.screen_to_world_2d(action.screen_x, action.screen_y)

		for id, data in pairs(self.slot_map) do
			local slot_world_pos = go.get_world_position(id)
			if vmath.length(slot_world_pos - world_pos) < 40 then
				place_station(self, id)
				break
			end
		end
	end
end