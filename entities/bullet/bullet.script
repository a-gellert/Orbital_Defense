local prog = require "main.progression"

go.property("speed", 300)
go.property("damage", 10)
go.property("is_enemy", false)
go.property("pierce", 0)

function init(self)
	self.life = 3.0
	self.hit_enemies = {}

	if self.is_enemy then
		sprite.play_flipbook("#sprite", "p_red")
	else
		if prog.is_overdrive then
			-- Огненная плазма в режиме Overdrive
			go.set("#sprite", "tint", vmath.vector4(2.5, 1.8, 0.4, 1.0))
			go.set_scale(vmath.vector3(1.35, 1.35, 1))
		else
			sprite.play_flipbook("#sprite", "p_blue")
		end

		-- Сочный вылет: пуля вытягивается как комета
		go.set_scale(vmath.vector3(0.5, 1.5, 1))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.0, 1.0, 1), go.EASING_OUTBACK, 0.12)
	end
end

function update(self, dt)
	local rot = go.get_rotation()
	local direction = vmath.rotate(rot, vmath.vector3(1, 0, 0)) 
	local pos = go.get_position()

	go.set_position(pos + direction * self.speed * dt)

	self.life = self.life - dt
	if self.life < 0 then go.delete() end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") and message.enter then
		local target_group = message.other_group

		-- 1. Пуля ИГРОКА попадает во ВРАГА
		if not self.is_enemy and target_group == hash("enemy") then
			if not self.hit_enemies[message.other_id] then
				self.hit_enemies[message.other_id] = true
				msg.post(message.other_id, "take_damage", { amount = self.damage or 10 })

				if self.pierce > 0 then
					self.pierce = self.pierce - 1
				else
					go.delete()
					return
				end
			end
		end

		-- 2. Пуля ВРАГА попадает в ПЛАНЕТУ
		if self.is_enemy and target_group == hash("planet") then
			msg.post(message.other_id, "take_damage", { 
				amount = self.damage or 5,
				attacker_id = go.get_id()
			})
			go.delete()
			return
		end
	end
end